PORT=5000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
# En Render: HOST=0.0.0.0 (automático en producción), TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=0
# Crea tablas si faltan antes de iniciar. No elimina datos.
AUTO_MIGRATE=false
# false = cuentas en PostgreSQL. true = cuentas locales, volátiles.
DEMO_MODE=false
DATABASE_URL=postgresql://savia:savia_local_password@localhost:5432/spotify_challenge
JWT_SECRET=
# musicbrainz (sin claves), spotify (con credenciales) o demo (8 canciones, sin red).
MUSIC_PROVIDER=musicbrainz
MUSICBRAINZ_USER_AGENT="Savia/1.0.0 (https://github.com/RubenIbaceta/API-buscador-musica)"
# Sólo necesarios con MUSIC_PROVIDER=spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=CL
