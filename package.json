{
  "name": "savia",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,white \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "db:migrate": "npm run db:migrate -w backend"
  },
  "devDependencies": {"concurrently": "^9.2.0"},
  "engines": {"node": ">=22.12"}
}
